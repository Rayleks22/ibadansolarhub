# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Pages / Workers Static Assets headers
# Deployed automatically from `public/_headers`. Added 5 Oct 2026.
#
# Audit reference: the live site was missing HSTS, frame protection, CSP and
# Permissions-Policy, and served every document with `max-age=0` so nothing was
# ever cached at the edge.
# ─────────────────────────────────────────────────────────────────────────────

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Deliberately permissive CSP: Google Fonts (stylesheet + font files), inline
# scripts (Astro islands hydrate inline) and inline styles (Tailwind + the print
# BOQ writer) all need allowances. Tighten once fonts are self-hosted.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Immutable, content-hashed build assets — safe to cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML documents: cache at the edge, serve stale while revalidating so repeat
# visits and crawls do not wait on origin.
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=3600

# Never let a 404 page or error response get cached.
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
