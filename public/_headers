# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Pages / Workers Static Assets headers
# Deployed automatically from `public/_headers`. Added 5 Oct 2026.
#
# Audit reference: the live site was missing HSTS, frame protection, CSP and
# Permissions-Policy, and served every document with `max-age=0` so nothing was
# ever cached at the edge.
# ─────────────────────────────────────────────────────────────────────────────

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# CSP. Fonts are now SELF-HOSTED, so Google Fonts has been removed from
# style-src, font-src and connect-src entirely — that closes a third-party
# origin that previously had script-adjacent reach into every page.
#
# Remaining allowances, and why each is needed:
#   'unsafe-inline' (script) — Astro islands hydrate with inline scripts.
#   'unsafe-inline' (style)  — Tailwind utility classes and the print-BOQ writer.
#   googletagmanager.com     — GA4, loaded ONLY when ANALYTICS.ga4Id is set.
#   google-analytics.com     — GA4 beacon endpoint (connect-src, + region1).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Immutable, content-hashed build assets — safe to cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400

# HTML documents: cache at the edge, serve stale while revalidating so repeat
# visits and crawls do not wait on origin.
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=3600

# Never let a 404 page or error response get cached.
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
