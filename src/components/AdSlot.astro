---
interface Props {
  slotType?: 'header-banner' | 'in-article' | 'sidebar' | 'footer-banner';
  client?: string;
  slotId?: string;
  sponsorName?: string;
  sponsorUrl?: string;
}

const { 
  slotType = 'in-article', 
  sponsorName = "Feature Your Solar Brand Here",
  sponsorUrl = "/quote"
} = Astro.props;
---

<div class="my-6 w-full overflow-hidden flex flex-col items-center">
  {/* Label */}
  <div class="text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">
    Advertisement / Sponsored
  </div>

  {/* Display Container */}
  <div class="w-full bg-slate-100 border border-dashed border-slate-300 rounded-xl p-4 md:p-6 text-center hover:bg-slate-50 transition">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left">
        <span class="inline-block px-2 py-0.5 bg-solar-100 text-solar-800 text-[10px] font-bold rounded mb-1">
          Partner Spotlight
        </span>
        <h3 class="text-sm md:text-base font-bold text-slate-900">
          Reach 50,000+ Nigerian Solar Buyers in Ibadan, Lagos, & Abuja
        </h3>
        <p class="text-xs text-slate-600 mt-0.5">
          Get high-converting leads for your solar installation company or distributor store.
        </p>
      </div>

      <a 
        href={sponsorUrl}
        class="inline-flex items-center gap-1 bg-slate-900 hover:bg-solar-500 hover:text-slate-950 text-white text-xs font-semibold py-2 px-4 rounded-lg transition whitespace-nowrap"
      >
        <span>Advertise With Us</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
