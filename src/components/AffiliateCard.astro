---
interface Props {
  title: string;
  category: string;
  brand: string;
  priceRange: string;
  verdict: string;
  pros?: string[];
  cons?: string[];
  affiliateLinks: Array<{
    name: string;
    url: string;
    retailer: string;
  }>;
  slug: string;
}

const {
  title,
  category,
  brand,
  priceRange,
  verdict,
  pros = [],
  cons = [],
  affiliateLinks = [],
  slug
} = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between">
  <div class="p-6">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="px-2.5 py-1 bg-amber-50 text-solar-700 text-xs font-bold rounded-lg border border-amber-200/60">
        {category}
      </span>
      <span class="text-xs font-semibold text-slate-500">
        Brand: {brand}
      </span>
    </div>

    <h3 class="text-lg font-bold text-slate-900 leading-snug">
      <a href={`/equipment/${slug}`} class="hover:text-solar-600 transition">
        {title}
      </a>
    </h3>

    <div class="mt-3 py-2 px-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
      <span class="text-xs text-slate-500 font-medium">Estimated Price in Nigeria:</span>
      <span class="text-sm font-extrabold text-slate-900">{priceRange}</span>
    </div>

    <p class="mt-4 text-xs text-slate-600 leading-relaxed">
      {verdict}
    </p>

    {pros.length > 0 && (
      <div class="mt-4 pt-4 border-t border-slate-100">
        <div class="text-[11px] font-bold uppercase tracking-wider text-green-700 mb-2">Key Advantages</div>
        <ul class="space-y-1 text-xs text-slate-600">
          {pros.slice(0, 2).map(pro => (
            <li class="flex items-start gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="p-6 bg-slate-50 border-t border-slate-100 space-y-2">
    <div class="text-[10px] text-slate-400 uppercase font-semibold text-center tracking-wider">
      Compare Verified Prices & Buy
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      {affiliateLinks.map(link => (
        <a
          href={link.url}
          target={link.url.startsWith('http') ? '_blank' : '_self'}
          rel={link.url.startsWith('http') ? 'sponsored nofollow noopener' : ''}
          class="inline-flex items-center justify-center gap-1.5 py-2 px-3 text-xs font-bold rounded-lg transition bg-white hover:bg-solar-500 hover:text-slate-950 text-slate-800 border border-slate-200 shadow-xs text-center"
        >
          <span>{link.name.replace('Check Price on ', '')}</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>
