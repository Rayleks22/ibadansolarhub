    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10">
      
      {/* Brand Column */}
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-2 min-h-11">
          <div class="w-8 h-8 rounded-lg bg-solar-500 flex items-center justify-center text-slate-950 font-black">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
