---
/**
 * /contact — required by affiliate and ad networks, and a trust signal on a
 * YMYL topic. Previously this path returned the homepage with HTTP 200.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, BUSINESS, WHATSAPP_DISPLAY } from '../config/site';
import { waLink } from '../lib/whatsapp';

const pageUrl = `${SITE.url}/contact/`;

const whatsappCta = waLink(
  'Hello IbadanSolarHub! I have a question about solar sizing / equipment prices / installer quotes.'
);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${pageUrl}#contactpage`,
      url: pageUrl,
      name: 'Contact IbadanSolarHub',
      inLanguage: 'en-NG',
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: BUSINESS.legalName,
      url: SITE.url,
      email: SITE.email,
      areaServed: { '@type': 'Country', name: 'Nigeria' },
    },
  ],
};
---

<BaseLayout
  title="Contact IbadanSolarHub — Solar Sizing Help & Installer Enquiries"
  description="Get in touch about solar system sizing, equipment prices, installer referrals, corrections to our data, or advertising and partnership enquiries."
  schema={schema}
>
  <section class="bg-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight">Contact Us</h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto">
        Fastest response is always WhatsApp. We answer sizing questions from real load lists,
        so the more detail you send, the more useful our answer will be.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-base font-black text-slate-900">WhatsApp (fastest)</h2>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          For sizing questions, quote checks, and installer referrals. Send your appliance list
          if you have one.
        </p>
        <a
          href={whatsappCta}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex w-full items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-4 rounded-xl text-sm transition"
        >
          Message us on WhatsApp
        </a>
        <p class="mt-3 text-center text-xs text-slate-500">{WHATSAPP_DISPLAY}</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-base font-black text-slate-900">Email</h2>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Best for advertising, partnership, installer-network and press enquiries, or anything
          that needs a written trail.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-4 inline-flex w-full items-center justify-center bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-xl text-sm transition break-all"
        >
          {SITE.email}
        </a>
        <p class="mt-3 text-center text-xs text-slate-500">
          ⚠️ Confirm this mailbox is live before publishing.
        </p>
      </div>

    </div>

    {/* Routing by enquiry type */}
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <h2 class="text-base font-black text-slate-900">Where to Go For…</h2>
      <dl class="mt-4 divide-y divide-slate-100 text-sm">
        <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <dt class="text-slate-700 font-medium">Get quotes from installers in my area</dt>
          <dd><a href="/quote" class="font-bold text-solar-700 hover:underline">Request quotes →</a></dd>
        </div>
        <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <dt class="text-slate-700 font-medium">Work out what size system I need</dt>
          <dd><a href="/calculator" class="font-bold text-solar-700 hover:underline">Use the calculator →</a></dd>
        </div>
        <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <dt class="text-slate-700 font-medium">Pay monthly instead of upfront</dt>
          <dd><a href="/solar-financing" class="font-bold text-solar-700 hover:underline">Solar financing →</a></dd>
        </div>
        <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <dt class="text-slate-700 font-medium">Join as a verified installer</dt>
          <dd><a href="/quote" class="font-bold text-solar-700 hover:underline">Installer network →</a></dd>
        </div>
        <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <dt class="text-slate-700 font-medium">Report an error in our data</dt>
          <dd><a href={`mailto:${SITE.email}?subject=Data%20correction`} class="font-bold text-solar-700 hover:underline">Email a correction →</a></dd>
        </div>
      </dl>
    </div>

    {/* Business details — placeholders until supplied */}
    <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-6">
      <h2 class="text-base font-black text-slate-900">Business Details</h2>
      <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
        Placeholder — to be completed by the site owner
      </p>
      <dl class="mt-4 space-y-2 text-sm">
        <div class="flex gap-3">
          <dt class="w-40 shrink-0 text-slate-500">Trading name</dt>
          <dd class="font-medium text-slate-800">{BUSINESS.legalName}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-40 shrink-0 text-slate-500">Registered address</dt>
          <dd class="font-medium text-slate-500">
            {BUSINESS.addressLine || 'Not published — set BUSINESS.addressLine in src/config/site.ts'}
          </dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-40 shrink-0 text-slate-500">Registration number</dt>
          <dd class="font-medium text-slate-500">
            {BUSINESS.registrationNumber || 'Not published — set BUSINESS.registrationNumber in src/config/site.ts'}
          </dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-40 shrink-0 text-slate-500">Service area</dt>
          <dd class="font-medium text-slate-800">Ibadan, Lagos, Ogun, Abuja, Port Harcourt &amp; nationwide referrals</dd>
        </div>
      </dl>
      <p class="mt-4 text-xs text-slate-500 leading-relaxed">
        Publishing a real registered address and RC number materially increases buyer trust and
        is required by some advertising networks. These fields are left blank rather than
        filled with invented details.
      </p>
    </div>

  </div>
</BaseLayout>
