---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';

// Group locations by state
const states = Array.from(new Set(locations.map(l => l.state)));
---

<BaseLayout
  title="Solar Installation Locations & DISCO Grid Hubs in Nigeria"
  description="Explore localized solar inverter packages, power grid reliability scores, and vetted solar installers in Ibadan, Lagos, Ogun, Abuja, and Port Harcourt."
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold text-solar-400 uppercase tracking-wider">Nationwide Coverage</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 tracking-tight">
        Solar Installation Hubs Across Nigeria
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto">
        Select your city or district to view local DISCO grid hours, irradiance ratings, recommended system sizes, and certified nearby installers.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-12">
      {states.map(state => {
        const stateLocations = locations.filter(l => l.state === state);
        return (
          <div>
            <div class="flex items-center gap-3 border-b border-slate-200 pb-3 mb-6">
              <h2 class="text-2xl font-black text-slate-900">{state}</h2>
              <span class="px-2.5 py-0.5 bg-solar-100 text-solar-800 text-xs font-bold rounded-full">
                {stateLocations.length} Hubs
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {stateLocations.map(loc => (
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-solar-500 hover:shadow-md transition flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-xs mb-2">
                      <span class="font-bold text-slate-500">{loc.city}</span>
                      <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 font-bold rounded">
                        Grid: {loc.avgDailyGridHours}
                      </span>
                    </div>

                    <h3 class="text-xl font-bold text-slate-900">
                      <a href={`/locations/${loc.slug}`} class="hover:text-solar-600 transition">
                        {loc.name}
                      </a>
                    </h3>

                    <p class="text-xs text-slate-500 mt-2 line-clamp-2">
                      {loc.description}
                    </p>

                    <div class="mt-4 pt-3 border-t border-slate-100 space-y-1.5 text-xs">
                      <div class="flex justify-between">
                        <span class="text-slate-600">DISCO Feeder:</span>
                        <span class="font-semibold text-slate-700 text-right truncate max-w-[180px]">{loc.disco}</span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-slate-600">Recommended System:</span>
                        <span class="font-bold text-solar-700">{loc.recommendedSystem}</span>
                      </div>
                      <div class="flex justify-between">
                        <span class="text-slate-600">Estimated Cost:</span>
                        <span class="font-bold text-slate-900">{loc.avgInstallationCost}</span>
                      </div>
                    </div>
                  </div>

                  <div class="mt-6 pt-4 border-t border-slate-100">
                    <a
                      href={`/locations/${loc.slug}`}
                      class="w-full inline-flex items-center justify-center py-2 px-4 bg-slate-900 hover:bg-solar-500 hover:text-slate-950 text-white font-bold text-xs rounded-xl transition"
                    >
                      View {loc.name} Solar Guide & Installers &rarr;
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
