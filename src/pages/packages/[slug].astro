---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import FinancingOffer from '../../components/FinancingOffer.astro';
import solarPackages from '../../data/solar-packages.json';
import { waLink } from '../../lib/whatsapp';
import { EARTHBOND } from '../../config/site';

export async function getStaticPaths() {
  return solarPackages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;

/**
 * Parse the leading kVA figure from the capacity string so we can decide
 * whether financing is contextually relevant.
 *   "5kVA / 48V (5000W)"  → 5
 *   "1.2kVA / 12V"        → 1.2
 *   "3.5kVA / 24V or 48V" → 3.5
 */
const pkgKva = parseFloat((pkg.capacity.match(/[\d.]+/) ?? ['0'])[0]);

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": pkg.name,
  "description": `Turnkey ${pkg.capacity} solar system in Nigeria. Includes pure sine wave inverter, lithium battery bank, solar panels, and installation.`,
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "NGN",
    "lowPrice": pkg.estimatedCost.split('–')[0].replace(/[^\d]/g, ''),
    "highPrice": pkg.estimatedCost.split('–')[1]?.replace(/[^\d]/g, '') || pkg.estimatedCost.replace(/[^\d]/g, ''),
    "offerCount": "10"
  }
};

const whatsappUrl = waLink(
  `Hello IbadanSolarHub! I am interested in the ${pkg.name} (${pkg.capacity}) setup. Please connect me with verified installers for an inspection and quote.`
);
---

<BaseLayout
  title={`${pkg.name} Price & Setup Guide Nigeria`}
  description={`Comprehensive Bill of Quantities (BOQ), appliance load capacity, and turnkey Nigerian price guide for the ${pkg.name}.`}
  schema={schema}
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-4">
        <a href="/" class="hover:text-solar-400">Home</a>
        <span>/</span>
        <a href="/packages" class="hover:text-solar-400">Packages</a>
        <span>/</span>
        <span class="text-white">{pkg.name}</span>
      </div>

      <div class="max-w-3xl">
        <span class="px-3 py-1 bg-solar-500/20 text-solar-400 border border-solar-500/30 text-xs font-bold rounded-full">
          {pkg.capacity} Sizing
        </span>
        <h1 class="text-3xl sm:text-5xl font-black mt-3 tracking-tight leading-tight">
          {pkg.name}
        </h1>
        <p class="mt-4 text-base text-slate-300">
          Ideal for: <span class="text-white font-medium">{pkg.idealFor}</span>
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-6 rounded-xl text-sm shadow-md transition"
          >
            Request Quotation & Site Inspection
          </a>
          <a
            href="/calculator"
            class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-medium py-3 px-5 rounded-xl text-sm border border-slate-700 transition"
          >
            Customize in Calculator &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      {/* Main Content */}
      <div class="lg:col-span-8 space-y-10">
        
        {/* Cost & Daily Output Card */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs font-semibold text-slate-500 uppercase">Estimated Turnkey Cost (Nigeria)</span>
            <div class="text-2xl font-black text-slate-900 mt-1">{pkg.estimatedCost}</div>
            <p class="text-xs text-slate-500 mt-2">Includes inverter, lithium storage, solar panels, and labor.</p>
          </div>

          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-xs font-semibold text-slate-500 uppercase">Expected Daily Solar Generation</span>
            <div class="text-2xl font-black text-solar-600 mt-1">{pkg.dailyOutputKwh}</div>
            <p class="text-xs text-slate-500 mt-2">Calculated under standard Nigerian solar radiation.</p>
          </div>
        </div>

        {/* Bill of Quantities (BOQ) */}
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <h2 class="text-2xl font-black text-slate-900">Standard Bill of Quantities (BOQ)</h2>
          <p class="text-xs text-slate-500 mt-1">Recommended tier-1 component breakdown for this installation.</p>

          <div class="mt-6 divide-y divide-slate-100 text-sm">
            <div class="py-3 flex flex-col sm:flex-row justify-between sm:items-center">
              <span class="text-slate-500 font-medium">Inverter Unit:</span>
              <span class="font-bold text-slate-900">{pkg.components.inverter}</span>
            </div>
            <div class="py-3 flex flex-col sm:flex-row justify-between sm:items-center">
              <span class="text-slate-500 font-medium">Battery Energy Storage:</span>
              <span class="font-bold text-slate-900">{pkg.components.battery}</span>
            </div>
            <div class="py-3 flex flex-col sm:flex-row justify-between sm:items-center">
              <span class="text-slate-500 font-medium">Solar PV Array:</span>
              <span class="font-bold text-slate-900">{pkg.components.panels}</span>
            </div>
            <div class="py-3 flex flex-col sm:flex-row justify-between sm:items-center">
              <span class="text-slate-500 font-medium">Charge Controller:</span>
              <span class="font-bold text-slate-900">{pkg.components.controller}</span>
            </div>
            <div class="py-3 flex flex-col sm:flex-row justify-between sm:items-center">
              <span class="text-slate-500 font-medium">Balance of System (BOS):</span>
              <span class="font-bold text-slate-900">{pkg.components.accessories}</span>
            </div>
          </div>
        </div>

        {/* Appliances Supported */}
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900">Appliances You Can Run Seamlessly</h3>
          <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700">
            {pkg.appliancesSupported.map((app) => (
              <li class="flex items-center gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-100">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span class="font-medium text-xs sm:text-sm">{app}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Pros & Cons */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-6 bg-emerald-50/60 rounded-2xl border border-emerald-200">
            <h4 class="text-sm font-bold text-emerald-900 uppercase tracking-wider">Advantages</h4>
            <ul class="mt-3 space-y-2 text-xs text-emerald-800">
              {pkg.pros.map(pro => (
                <li class="flex items-start gap-2">
                  <span class="font-black text-emerald-600">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-6 bg-amber-50/60 rounded-2xl border border-amber-200">
            <h4 class="text-sm font-bold text-amber-900 uppercase tracking-wider">Limitations</h4>
            <ul class="mt-3 space-y-2 text-xs text-amber-800">
              {pkg.cons.map(con => (
                <li class="flex items-start gap-2">
                  <span class="font-black text-amber-600">!</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <AdSlot slotType="in-article" sponsorName="Top Solar Inverter Brands in Nigeria" />
      </div>

      {/* Sidebar */}
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm sticky top-24 space-y-6">
          <h3 class="text-base font-bold text-slate-900">Request Installer Inspection</h3>
          <p class="text-xs text-slate-500">
            Connect with verified solar engineers in your city to inspect your roof and give an exact quotation.
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-4 rounded-xl text-xs shadow-md transition"
          >
            Chat with Verified Installer on WhatsApp
          </a>

          <FinancingOffer kva={pkgKva} variant="package" />

          <div class="pt-4 border-t border-slate-100">
            <h4 class="text-xs font-bold text-slate-900 mb-2">Want the Full Sizing Spreadsheet?</h4>
            <p class="text-xs text-slate-500 mb-3">
              Download our customizable Excel & Google Sheets BOQ calculator with Nigerian market formulas.
            </p>
            <a
              href="/products"
              class="w-full inline-flex items-center justify-center py-2 px-3 bg-solar-50 hover:bg-solar-100 text-solar-900 border border-solar-200 rounded-lg text-xs font-bold transition"
            >
              Get BOQ Spreadsheet (₦3,000) &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
