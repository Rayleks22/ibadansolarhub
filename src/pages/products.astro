---
import BaseLayout from '../layouts/BaseLayout.astro';
import digitalProducts from '../data/digital-products.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Nigerian Solar Guides & Digital Tools",
  "itemListElement": digitalProducts.map((prod, idx) => ({
    "@type": "Product",
    "position": idx + 1,
    "name": prod.title,
    "description": prod.description,
    "offers": {
      "@type": "Offer",
      "price": prod.priceNgn,
      "priceCurrency": "NGN",
      "availability": "https://schema.org/InStock"
    }
  }))
};
---

<BaseLayout
  title="Solar Digital Guides, Blueprints & Excel Spreadsheets Nigeria"
  description="Master solar system sizing, avoid counterfeit batteries, and estimate turnkey project costs with our downloadable Nigerian solar guides and spreadsheets."
  schema={schema}
>
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold text-solar-400 uppercase tracking-wider">Instant Downloads</span>
      <h1 class="text-3xl sm:text-5xl font-black mt-2 tracking-tight">
        Solar Blueprints, BOQ Spreadsheets & Guides
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto">
        Avoid costly mistakes, avoid fake lithium batteries, and audit installer quotes with precision. Instant delivery to your email upon payment via Paystack.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="space-y-12">
      {digitalProducts.map((prod) => (
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm hover:shadow-md transition grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-8">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 bg-solar-100 text-solar-800 text-xs font-bold rounded-md">
                {prod.format}
              </span>
              <span class="text-xs text-emerald-600 font-semibold flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Instant Email Delivery
              </span>
            </div>

            <h2 class="text-2xl font-black text-slate-900 mt-2">
              {prod.title}
            </h2>

            <p class="text-sm text-slate-600 mt-3 leading-relaxed">
              {prod.description}
            </p>

            <div class="mt-5">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">What's Included:</h4>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600">
                {prod.highlights.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-solar-600 font-bold">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="lg:col-span-4 bg-slate-50 p-6 rounded-2xl border border-slate-100 text-center flex flex-col justify-between h-full">
            <div>
              <span class="text-xs text-slate-400 uppercase font-semibold">One-Time Payment</span>
              <div class="mt-2 flex items-baseline justify-center gap-2">
                <span class="text-3xl font-black text-slate-900">₦{prod.priceNgn.toLocaleString()}</span>
                <span class="text-sm text-slate-400 line-through">₦{prod.originalPriceNgn.toLocaleString()}</span>
              </div>
              <span class="inline-block mt-1 text-[11px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">
                Save 60% Today
              </span>
            </div>

            <div class="mt-6 space-y-3">
              <a
                href={prod.paystackUrl}
                target="_blank"
                rel="noopener"
                class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl text-sm shadow-md transition"
              >
                <span>Buy Now via Paystack</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <div class="text-[10px] text-slate-400 flex items-center justify-center gap-1">
                🔒 Secure 256-bit encryption (Card, Bank Transfer, USSD)
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</BaseLayout>
